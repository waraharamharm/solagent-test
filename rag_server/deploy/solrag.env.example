# Copy to ~/solrag/solrag.env on the server and run: chmod 600 ~/solrag/solrag.env
# Read by solrag.service (EnvironmentFile). Real values never go into git.

# FCM service account JSON from Firebase: Project settings -> Service accounts ->
# Generate new private key. Keep it outside the repo and the app data dir.
SOLRAG_FCM_CREDENTIALS=/home/USER/solrag/secrets/fcm-service-account.json
